<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - منصة تنسيق وإدارة الأزمات</title>
    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts (Cairo) -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f4f6f9;
        }
        /* Sidebar Styling */
        .sidebar {
            width: 260px;
            background-color: #ffffff;
            border-left: 1px solid #e3e6f0;
            min-height: calc(100vh - 65px);
        }
        .sidebar .nav-link {
            color: #4a5568;
            padding: 12px 20px;
            font-weight: 600;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: all 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background-color: #ebf8ff;
            color: #2b6cb0;
        }
        .top-navbar {
            height: 65px;
            background: #ffffff;
            border-bottom: 1px solid #e3e6f0;
        }
    </style>
</head>
<body>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand top-navbar px-4 sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold text-primary d-flex align-items-center" href="/">
                <i class="bi bi-shield-shaded fs-3 me-2"></i>
                <span>منصة تنسيق وإدارة الأزمات</span>
            </a>
            <div class="d-flex align-items-center">
                <div class="dropdown">
                    <button class="btn btn-light border dropdown-toggle..." type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-badge-fill text-primary me-2"></i>
                        <span>منسق مركز / جهة الإدارة المركزية</span>
                    </button>
                    <ul class="dropdown-menu shadow border-0 text-end">
                        <li><a class="dropdown-item" href="#">صلاحية تنفيذية معتمدة</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#">تسجيل الخروج</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar  -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse p-3">
                <div class="position-sticky">
                    <h6 class="text-muted text-uppercase fs-7 fw-bold mb-3 px-3">اللوحات التشغيلية الميدانية</h6>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2"></i> لوحة التحكم الإحصائية
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Crisis" asp-action="Index">
                                <i class="bi bi-exclamation-triangle me-2"></i> إدارة الأزمات والطوارئ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-geo-alt me-2"></i> المناطق المتأثرة ميدانياً
                            </a>
                        </li>
                    </ul>
                    <hr class="my-4 text-muted">
                    <h6 class="text-muted text-uppercase fs-7 fw-bold mb-3 px-3">المراحل القائمة</h6>
                    <ul class="nav flex-column text-muted small">
                        <li class="nav-link disabled text-secondary"><i class="bi bi-dot"></i> الاستعلامات والجهات الخارجية</li>
                        <li class="nav-link disabled text-secondary"><i class="bi bi-dot"></i> تنسيق المساعدات الدولية</li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content Area -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-center py-3 border-top bg-white text-muted small">
        <span>منظومة الاستجابة الميدانية السريعة © 2026 الإدارة المركزية لتنسيق الإنساني وإدارة الطوارئ. كافة الحقوق محفوظة.</span>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>