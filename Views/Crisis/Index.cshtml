@model IEnumerable<CrisisManagementPlatform.Models.Crisis>

@{
    ViewData["Title"] = "قائمة الأزمات";
}

<div class="container-fluid">
    <!-- Header Title & Action -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border-start border-primary border-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-shield-exclamation text-primary me-2"></i> إدارة الأزمات</h4>
            <p class="text-muted mb-0 small">استعراض ومتابعة الأزمات الإنسانية والتشغيلية المسجلة في النظام وتحديد حالتها وفق البروتوكول القيادي المعتمد.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> تسجيل أزمة جديدة
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Real Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">أزمات تحت التدخل (نشطة)</span>
                        <h4 class="fw-bold mb-0 text-danger">@ViewBag.ActiveCount أزمات</h4>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-3 fs-4 ms-2"><i class="bi bi-activity"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">أزمات مسجلة (قيد الاعتماد)</span>
                        <h4 class="fw-bold mb-0 text-warning">@ViewBag.RegisteredCount أزمات</h4>
                    </div>
                    <div class="bg-warning-subtle text-warning-emphasis p-3 rounded-3 fs-4 ms-2"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">إجمالي الأزمات المسجلة</span>
                        <h4 class="fw-bold mb-0 text-primary">@ViewBag.TotalCount أزمة</h4>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-3 fs-4 ms-2"><i class="bi bi-shield-check"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Bar  -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control bg-light border-start-0" placeholder="ابحث برمز الأزمة أو الاسم أو التصنيف..." />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-filter"></i></span>
                    <select name="statusFilter" class="form-select bg-light border-start-0">
                        <option value="">-- الكل (جميع الحالات) --</option>
                        @if (ViewBag.StatusFilter?.ToString() == "0")
                        {
                            <option value="0" selected>مسجلة (قيد الاعتماد)</option>
                        }
                        else
                        {
                            <option value="0">مسجلة (قيد الاعتماد)</option>
                        }

                        @if (ViewBag.StatusFilter?.ToString() == "1")
                        {
                            <option value="1" selected>نشطة</option>
                        }
                        else
                        {
                            <option value="1">نشطة</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold shadow-sm">
                    <i class="bi bi-funnel me-1"></i> تطبيق التصفية
                </button>
                <a asp-action="Index" class="btn btn-light border text-secondary px-3 rounded-3" title="إعادة تعيين">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h6 class="mb-0 fw-bold text-secondary"><i class="bi bi-list-task me-2"></i> سجل الأزمات الميدانية المسجلة</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light text-secondary fs-7">
                        <tr>
                            <th class="text-end py-3 px-4">عنوان الأزمة</th>
                            <th>التصنيف الأساسي/التقييم</th>
                            <th>تاريخ البدء</th>
                            <th>الحالة التشغيلية</th>
                            <th>تاريخ التسجيل</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-end fw-bold px-4">@item.Title</td>
                                    <td><span class="badge bg-light text-dark border px-2 py-1">@(item.CrisisCategory?.Name ?? "عام")</span></td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                    <td>
                                        @if (item.Status == CrisisManagementPlatform.Models.CrisisStatus.Active)
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-semibold">نشطة</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill fw-semibold">مسجلة (قيد الاعتماد)</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (item.Status == CrisisManagementPlatform.Models.CrisisStatus.Registered)
                                        {
                                            <form asp-action="Activate" asp-route-id="@item.CrisisId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm">
                                                    <i class="bi bi-play-fill me-1"></i> تفعيل
                                                </button>
                                            </form>
                                        }
                                        <a href="#" class="btn btn-sm btn-light border text-primary rounded-pill px-3 ms-1">
                                            <i class="bi bi-eye"></i> عرض
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-black-50"></i>
                                    لا توجد أي أزمات مطابقة للبحث أو مسجلة حتى الآن.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>